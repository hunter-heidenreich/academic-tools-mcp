# Cache location (optional). Where the on-disk response cache lives. Defaults
# to a ".cache" directory next to the project; set this when running from an
# installed wheel or anywhere the project tree isn't writable. "~" is expanded.
# CACHE_DIR=~/.cache/academic-tools-mcp

# OpenAlex API configuration
# Get a free API key at https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Crossref API configuration
# Provide a mailto email to use the polite pool (higher rate limits)
# See https://www.crossref.org/documentation/retrieve-metadata/rest-api/
CROSSREF_MAILTO=

# Wikipedia API configuration
# Email for the User-Agent header (required by Wikimedia policy)
WIKIPEDIA_MAILTO=

# PDF-to-markdown conversion (optional — only needed for paper PDF pipeline)
# Named backends: "mineru" (default), "marker"
# Custom: any command template with {input} and {output_dir} placeholders
#   e.g. PDF_CONVERTER=my-tool --in "{input}" --out "{output_dir}"
PDF_CONVERTER=mineru
# Optional: path to a virtualenv to activate before running the converter
# PDF_CONVERTER_VENV=~/.venvs/mineru
# Optional: hard timeout for a single PDF→markdown conversion, in seconds.
# Default 1800 (30 min). Set to "none" / "off" / "disabled" to disable.
# PDF_CONVERT_TIMEOUT=1800

# Fast/degraded extraction backend for convert_paper(mode="fast"). A lightweight
# text-only fallback that runs outside the global conversion lock — no tables,
# equations, figures, or real headings. Must emit extracted text to stdout.
# Named backends: "pdftotext" (default; needs system poppler-utils),
#   "pymupdf" (needs `pip install academic-tools-mcp[fast]`).
# Custom: any command template with an {input} placeholder ({python} expands to
#   the server's interpreter), e.g. PDF_FAST_CONVERTER=my-extractor "{input}"
# PDF_FAST_CONVERTER=pdftotext
# Optional: hard timeout for a single fast extraction, in seconds. Default 120.
# Set to "none" / "off" / "disabled" to disable.
# PDF_FAST_CONVERT_TIMEOUT=120
# Optional: hard cap on PDF download size in bytes. Default 200_000_000
# (~200 MB). A streaming download that exceeds this is aborted and the
# partial file is unlinked. Set to "none" / "off" / "0" to disable.
# MAX_PDF_BYTES=200000000
